# OpenAI API配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 如果使用其他兼容的API服务，修改下面的URL
# 例如：
# OPENAI_BASE_URL=https://your-custom-api-endpoint.com/v1
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.zhipuai.cn/api/paas/v4

# 平台配置
PLATFORM_HOST=0.0.0.0
PLATFORM_PORT=8000
DEBUG_MODE=true

# 安全配置
MAX_FILE_SIZE_MB=10
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT_MB=128

# 可选：Weather API配置（如果使用示例Agent）
WEATHER_API_KEY=your_weather_api_key_here